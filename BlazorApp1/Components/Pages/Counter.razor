@page "/counter"
@rendermode InteractiveServer

<PageTitle>Counter</PageTitle>


<h1 class="news-title">¡Desafía tu récord personal! 🔢</h1>
<div class="news-card">
    <p role="status">Contador actual: <b>@currentCount</b></p>
    <button class="btn btn-primary" @onclick="IncrementCount">¡Súbelo ahora!</button>
</div>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
